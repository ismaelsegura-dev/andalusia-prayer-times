# Connection string de MongoDB Atlas (ponla también en Vercel > Settings > Environment Variables)
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Opcional: nombre de la base de datos (por defecto falak-qayran)
# MONGODB_DB=falak-qayran

# Opcional: hash SHA-256 de la clave del emir (por defecto usa el mismo que la app)
# ADMIN_PASSWORD_HASH=6fa88707d2f757f246e2bf7f71a17bf76e6fe2599b4ba1615e66fb410469e9b9
